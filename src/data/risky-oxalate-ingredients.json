    "blé": {
      "level": "modéré",
      "justification": "blé raffiné : pains 16,5-45,9 mg/100 g (Okombo & Liebman 2010), pâtes 20-30 mg/100 g (Liebman & Okombo 2009) ; classement par 100 g (choix-pates-oxalate.md)"
    },
    "blé complet": {
      "level": "élevé",
      "justification": "blé complet : grain entier 53,3-76,6 mg/100 g, farine et flocons complets comparables (Siener et al. 2006, PMID 16608223)"
    },
    "son de blé": {
      "level": "très élevé",
      "justification": "son de blé 207-457,4 mg/100 g (base OHF ; Siener et al. 2006)"
    },
    "petit-beurre": {
      "level": "modéré",
      "justification": "biscuit à 73,5 % de farine de blé, 13,6 % de beurre, sucre, lait écrémé en poudre, sel (recette LU, https://fr.wikipedia.org/wiki/Petit_Beurre) : niveau du blé raffiné ; rangé par OFF sous en:biscuit et non sous en:wheat"
    },
    "avoine": {
      "level": "modéré",
      "justification": "avoine : flocons ~22 mg/100 g, farine 32 mg/100 g (OHF) ; classement par 100 g comme le blé"
    },
    "son d'avoine": {
      "level": "élevé",
      "justification": "son d'avoine 37-67 mg/100 g (Siener et al. 2006, PMID 16608223), 79 mg/100 g (base OHF)"
    },
    "chocolat": {
      "level": "très élevé",
      "justification": "Candy, Dark Chocolate 232 mg/100 g ; Candy, Milk Chocolate 115 mg/100 g (OHF)"
    },
    "cacao": {
      "level": "très élevé",
      "justification": "Cocoa or Cacao Powder, Dark Chocolate 656 mg/100 g ; Cocoa Powder, Dutch Process 170 mg/100 g (OHF)"
    }
